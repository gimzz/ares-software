<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/8.0.171"
    xmlns:fx="http://javafx.com/fxml/1"
    spacing="12" alignment="CENTER_LEFT" styleClass="nav">
    <padding>
        <Insets top="8" right="10" bottom="8" left="10" />
    </padding>
    <children>
        <Button fx:id="btnDashboardTop" text="Dashboard" mnemonicParsing="false" style="-fx-background-color:#00CCFF; -fx-font-weight:bold;" />
        <Button fx:id="btnUsuariosTop" text="Usuarios" mnemonicParsing="false" />
        <MenuButton fx:id="btnAjustesTop" text="Ajustes" mnemonicParsing="false">
            <items>
                <MenuItem fx:id="miToggleTop" text="Cambiar menú" />
            </items>
        </MenuButton>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnLogoutTop" text="Cerrar sesión" mnemonicParsing="false" style="-fx-background-color:#FF6666; -fx-text-fill:white;" />
    </children>
</HBox>