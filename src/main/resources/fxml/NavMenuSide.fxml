<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
    xmlns:fx="http://javafx.com/fxml/1"
    spacing="8" prefWidth="180" styleClass="nav">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>
    <children>
        <Button fx:id="btnDashboardSide" text="Dashboard" mnemonicParsing="false" prefWidth="160" style="-fx-background-color:#00CCFF; -fx-font-weight:bold;" />
        <Button fx:id="btnUsuariosSide" text="Usuarios" mnemonicParsing="false" prefWidth="160" />
        <MenuButton fx:id="btnAjustesSide" text="Ajustes" mnemonicParsing="false" prefWidth="160">
            <items>
                <MenuItem fx:id="miToggleSide" text="Cambiar menú" />
            </items>
        </MenuButton>
        <Region VBox.vgrow="ALWAYS" />
        <Button fx:id="btnLogoutSide" text="Cerrar sesión" mnemonicParsing="false" prefWidth="160" style="-fx-background-color:#FF6666; -fx-text-fill:white;" />
    </children>
</VBox>