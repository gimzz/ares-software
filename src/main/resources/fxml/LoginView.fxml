<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aressoftware.controller.LoginController"
            prefWidth="800" prefHeight="600"
            style="-fx-background-color: #2D3C44;">

    <children>
        <VBox spacing="15" alignment="CENTER"
              prefWidth="300"
              AnchorPane.topAnchor="100" AnchorPane.leftAnchor="250" AnchorPane.rightAnchor="250">

            <children>
                <ImageView fx:id="imageView"
                           fitHeight="250" fitWidth="250"
                           pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@/img/logo.png" />
                    </image>
                </ImageView>

                <Label text="Iniciar Sesión"
                       style="-fx-font-size: 24px; -fx-text-fill: #FFD700; -fx-font-weight: bold;" />

                <TextField fx:id="txtUsername"
                           promptText="Usuario"
                           prefWidth="250"
                           style="-fx-background-radius: 8; -fx-background-color: #F0F0F0; -fx-padding: 8;" />

                <PasswordField fx:id="txtPassword"
                               promptText="Contraseña"
                               prefWidth="250"
                               style="-fx-background-radius: 8; -fx-background-color: #F0F0F0; -fx-padding: 8;" />

                <Label fx:id="lblMessage"
                       style="-fx-text-fill: red; -fx-font-size: 14px;" />

                <Button fx:id="btnLogin"
                        text="Ingresar"
                        onAction="#handleLogin"
                        prefWidth="250"
                        style="-fx-background-color: #00CCFF; -fx-text-fill: #2D3C44; -fx-font-weight: bold; -fx-background-radius: 8;" />
            </children>
        </VBox>
    </children>
</AnchorPane>