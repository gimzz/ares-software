<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.aressoftware.controller.NavMenuSideController"
      fx:id="navRoot"
      spacing="10"
      styleClass="nav-container"
      VBox.vgrow="ALWAYS">

    <children>
        <!-- Logo arriba -->
        <ImageView fx:id="logoImage"
                   fitWidth="180"
                   preserveRatio="true"
                   VBox.vgrow="NEVER"/>

        <!-- Espacio entre logo y botones -->
        <Region prefHeight="20"/>

        <!-- Botones del menú -->
        <Button fx:id="btnInicio"
                text="Inicio"
                onAction="#handleInicio"
                styleClass="nav-button"/>
        <Button fx:id="btnProductos"
                text="Productos"
                onAction="#handleProductos"
                styleClass="nav-button"/>
        <Button fx:id="btnUsuarios"
                text="Usuarios"
                onAction="#handleUsuarios"
                styleClass="nav-button"/>
        <Button fx:id="btnVentas"
                text="Ventas"
                onAction="#handleVentas"
                styleClass="nav-button"/>

        <!-- Espaciador inferior -->
        <Region VBox.vgrow="ALWAYS"/>
    </children>
</VBox>