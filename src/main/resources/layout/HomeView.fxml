<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aressoftware.controller.HomeController"
            fx:id="rootPane">

    <top>
        <fx:include source="/components/header/Header.fxml"/>
    </top>

    <left>
        <VBox styleClass="sidebar-container" alignment="TOP_CENTER">
            
            <Region prefHeight="70" VBox.vgrow="NEVER" /> 
            
            <fx:include source="/components/nav/NavMenuSide.fxml"/>
        </VBox>
    </left>

    <center>
        <AnchorPane fx:id="mainContent"/>
    </center>
</BorderPane>